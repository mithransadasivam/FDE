# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./data/hiring.db
STORAGE_DIR=storage
RETENTION_DAYS=180
SECRET_KEY=change-me-to-a-long-random-text
# 1 = built-in fakes, no key needed (tests always use this)
FAKE_MODELS=1
LLM_MODEL=openrouter/anthropic/claude-haiku-4.5
VISION_MODEL=openrouter/google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=
WHISPER_MODEL=base.en
# Full path to tesseract.exe if it is installed but not on PATH (optional; the rapidocr fallback is used otherwise)
TESSERACT_CMD=
# ---- Model router (used when FAKE_MODELS=0). Fake mode records the same cost figures as if these were called.
LARGE_MODEL=openrouter/anthropic/claude-haiku-4.5
SMALL_MODEL=openrouter/google/gemini-2.5-flash-lite
LOCAL_MODEL=ollama/llama3.1
FALLBACK_MODEL=openrouter/openai/gpt-4o-mini
ROUTER_ENABLED=1
CACHE_ENABLED=1
GUARDRAILS_ENABLED=1
PHOENIX_ENDPOINT=
# Shows the demo accounts on the sign-in page (fictional demo data only; leave 0 for anything real)
DEMO_MODE=1
