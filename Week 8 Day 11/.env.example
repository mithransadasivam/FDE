# Copy to .env and add your key. Never commit .env.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id that follows instructions well.
# Day 6: the vision method sends a picture of the page, so use a model that reads images (the class uses Haiku 5.5).
FDE_MODEL=anthropic/claude-haiku-5.5
# Day 7: the data agent writes SQL with the same model. No key? FDE_FAKE_LLM=1 answers the course questions.

# Day 5: Amazon Bedrock in your AWS account. Uses your AWS credentials (aws configure): no key here.
# FDE_LLM_PROVIDER=bedrock
FDE_BEDROCK_REGION=eu-west-2
# ADR-001's choice. Check where it runs on Pilot → Platform before you use it.
FDE_BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-5-5
# Set by python -m scripts.pilot_env after terraform apply:
# FDE_GUARDRAIL_ID=
# FDE_GUARDRAIL_VERSION=

# Day 8: the bank's systems (:8100) and the MCP server (:8200) run on your laptop; the defaults need no change.
# Stretch: a real Slack incoming webhook from the workspace you created (Day 1 checklist). Never commit it.
# FDE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Day 9: the operations agent runs inside the console's API. A run waits this long for a person's approval, then stops.
# FDE_APPROVAL_WAIT_S=600
# CaseFlow Classic, the bank's legacy case system (it has no API): on the bank's server.
# FDE_LEGACY_URL=http://localhost:8100/legacy

# Day 10: durable workflows. The worker (python -m app.workflow.worker) runs the case workflows; npm run dev starts it,
# and starts it again whenever it crashes. Progress is kept in engagement/workflow/dbos.sqlite.
# How long one course "day" lasts, in seconds (the chase waits 3 days for a reminder, 7 for an escalation). At the bank: 86400.
# FDE_DAY_SECONDS=20
# The prompt the case workflows give the agent:
# FDE_WORKFLOW_PROMPT=ops_v3
