# Copy to .env and fill in. Never commit .env. Without a key the tower runs on the built-in fake model (fine for a demo of the rules).
OPENROUTER_API_KEY=
# Large model: incident briefs, summaries, drafts, hard questions
LLM_MODEL=anthropic/claude-haiku-4.5
# Small model: investigator turns, status drafts, simple runbook and policy look-ups
SMALL_MODEL=google/gemini-2.5-flash-lite
# US dollars per million tokens (check openrouter.ai)
INPUT_PRICE=1.00
OUTPUT_PRICE=5.00
SMALL_INPUT_PRICE=0.10
SMALL_OUTPUT_PRICE=0.40
# Part 2 switches (baseline = both off)
ROUTING=1
CACHE=1
CACHE_TTL_S=60
# MODEL_MODE=fake        # force the offline fake model even when a key is present
# TOWER_NOW=2026-10-24 13:04
