# Copy to .env and add your key. Never commit .env.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id that follows instructions well
FDE_MODEL=anthropic/claude-sonnet-4.5

# Day 5: Amazon Bedrock in your AWS account. Uses your AWS credentials (aws configure): no key here.
# FDE_LLM_PROVIDER=bedrock
FDE_BEDROCK_REGION=eu-west-2
# ADR-001's choice. Check where it runs on Pilot → Platform before you use it.
FDE_BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-5-5
# Set by python -m scripts.pilot_env after terraform apply:
# FDE_GUARDRAIL_ID=
# FDE_GUARDRAIL_VERSION=
