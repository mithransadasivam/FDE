# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=your-key-here
LLM_MODEL=your-model-name-on-openrouter
# Optional: dollars per million tokens, used for the cost numbers
INPUT_PRICE=0
OUTPUT_PRICE=0
# Optional: seconds between model calls (OpenRouter free accounts allow ~20 per minute)
LLM_MIN_INTERVAL=3.2

# Optional: path to a .env kept outside the project folder
# ENV_FILE=D:\path	o\.env
