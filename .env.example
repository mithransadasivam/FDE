# Copy any new lines into your own .env and fill in real values. Never commit .env.

# Hosted models through OpenRouter (from Day 2)
OPENROUTER_API_KEY=your-key-here
LLM_MODEL=anthropic/claude-haiku-4.5

# New on Day 3: prices in US dollars per million tokens for LLM_MODEL.
# Copy the current numbers from the model's page on openrouter.ai.
INPUT_PRICE=0
OUTPUT_PRICE=0

# New on Day 3: the local model served by Ollama
LOCAL_MODEL=llama3.2

# Homework 3: the model registry in app/chatbot.py is built from these variables.
# Adding a model = add its name to BACKENDS and set its five NAME_* variables.
# Prices are $ per 1M tokens, from openrouter.ai (checked 2026-09-28).
BACKENDS=hosted,strong,local
DEFAULT_BACKEND=hosted

HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_KEY_VAR=OPENROUTER_API_KEY
HOSTED_MODEL=anthropic/claude-haiku-4.5
HOSTED_IN_PRICE=1.00
HOSTED_OUT_PRICE=5.00

STRONG_BASE_URL=https://openrouter.ai/api/v1
STRONG_KEY_VAR=OPENROUTER_API_KEY
STRONG_MODEL=anthropic/claude-sonnet-4.5
STRONG_IN_PRICE=3.00
STRONG_OUT_PRICE=15.00

# LOCAL_MODEL is also set above; Ollama needs no real key
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_KEY_VAR=OLLAMA_KEY
LOCAL_IN_PRICE=0
LOCAL_OUT_PRICE=0
